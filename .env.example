# Supabase project (public — safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — bypasses RLS, used exclusively by trusted API route handlers
# for ticket issuance, seat locking, and payment confirmation.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Prisma (Supabase: pooled connection for runtime queries, direct for migrations)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# HMAC ticket signing — one active key + optional prior key for rotation.
# Never reuse across environments. Rotate by bumping TICKET_HMAC_KEY_VERSION
# and moving the old secret into TICKET_HMAC_SECRET_PREVIOUS.
TICKET_HMAC_SECRET=replace-with-64-byte-random-hex
TICKET_HMAC_KEY_VERSION=1
TICKET_HMAC_SECRET_PREVIOUS=
